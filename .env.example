# Supabase (Authentication, PostgreSQL, Storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: apply supabase/migrations/001_initial_schema.sql via `npm run db:apply`
# Create a personal access token at https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Server-side database writes from POST /api/jobs/analyze
# Use the service role key. Never prefix this with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM (required for live job analysis)
# Never expose this in frontend code or VITE_ variables.
# OpenAI example:
LLM_API_KEY=sk-your-openai-key
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Compatible providers: set LLM_API_BASE_URL to that vendor's OpenAI-style
# chat/completions root, for example https://api.groq.com/openai/v1
# API_PORT=8787

# Leave unset so the browser calls same-origin /api (Vite proxy locally,
# Vercel serverless function in production). Never set this to
# http://127.0.0.1:8787 in a Vercel environment.
# VITE_API_BASE_URL=

# Auto Apply: `npm run dev` embeds the agent scheduler and browser worker in the API.
# Visible separate processes: `npm run agent` and `npm run worker`.
# Combined: `npm run dev:agent` (API + client + agent + worker).
# Local synthetic employer: set JOBPILOT_INCLUDE_SYNTHETIC=1 or pass includeSynthetic
# on /api/jobs/auto-apply/start so the agent can discover http://127.0.0.1:8787/test-employer.
# Vercel serverless cannot keep a Playwright session. After npm install, run:
# npm run playwright:install
# PLAYWRIGHT_NO_SANDBOX=1
# JOBPILOT_EMBED_AGENT=0
# JOBPILOT_EMBED_WORKER=0
# JOBPILOT_INCLUDE_SYNTHETIC=1
# JOBPILOT_RUNTIME_DIR=/tmp/jobpilot-automation

# Live job discovery (server-side only — never prefix these with VITE_)
# Jooble US API: POST https://jooble.org/api/{JOOBLE_API_KEY}
JOOBLE_API_KEY=
JOOBLE_ENABLED=true
# JOOBLE_API_BASE_URL=https://jooble.org/api

# USAJOBS Search API: GET https://data.usajobs.gov/api/search
USAJOBS_API_KEY=
USAJOBS_USER_AGENT_EMAIL=
USAJOBS_ENABLED=true

# Job Opportunities API (keyless public US listings)
# GET https://api.jobopportunitiesapi.org/public/jobs
# Do not add an API key. The public endpoint is intentionally keyless.
JOB_OPPORTUNITIES_ENABLED=true
# JOB_OPPORTUNITIES_API_BASE_URL=https://api.jobopportunitiesapi.org
