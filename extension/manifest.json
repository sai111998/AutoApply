{
  "manifest_version": 3,
  "name": "JobPilot Application Agent",
  "version": "0.1.0",
  "description": "Detects employer application pages for JobPilot. Does not submit applications.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobPilot Detection"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*",
    "http://127.0.0.1:5173/*",
    "http://localhost:5173/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1:5173/*",
      "http://localhost:5173/*",
      "http://127.0.0.1:8787/*",
      "http://localhost:8787/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:8787/extension/test/*",
        "http://localhost:8787/extension/test/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
